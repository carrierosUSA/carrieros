# Public project coordinates (safe for the browser; RLS still applies)
TRANSPO_ENVIRONMENT=development
TRANSPO_EXPECTED_SUPABASE_PROJECT_REF=YOUR_DEVELOPMENT_PROJECT_REF
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
NOVA_MODEL=gpt-5.4

# Document intake
ALPH_OCR_PROVIDER=openai
ALPH_DOCUMENT_MODEL=gpt-5.4
ALPH_DOCUMENT_BUCKET=company-documents
ALPH_DOCUMENT_MAX_BYTES=15728640
